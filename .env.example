# PostgreSQL connection string.
# Hosted (Neon, Supabase, Prisma Postgres…) or local, e.g.:
#   postgresql://postgres:postgres@localhost:5432/appify
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appify"

# Secret used to sign admin session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string-of-32-plus-chars"

# Initial admin account, created by `npm run db:seed` (or `npm run admin:create`).
# Change the password after first login (Admin → Settings).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
