# Database connection string.
# Local (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — also set provider = "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign admin session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string-of-32-plus-chars"

# Initial admin account, created by `npm run db:seed` (or `npm run admin:create`).
# Change the password after first login (Admin → Settings).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
