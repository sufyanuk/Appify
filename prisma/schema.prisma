// Prisma schema — the single source of truth for the database structure.
//
// Local development uses SQLite (zero setup, a file at prisma/dev.db).
// For production, change `provider` to "postgresql" and point DATABASE_URL
// at a hosted Postgres (Neon, Supabase, Railway…). No other code changes needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FoodItem {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  /// Price in cents (integer) to avoid floating point rounding errors.
  priceCents  Int
  image       String      @default("")
  category    String      @default("Other")
  available   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([available])
  @@index([category])
}

model Order {
  /// Internal sequential id — used to build the human readable order number.
  id           Int         @id @default(autoincrement())
  /// Unguessable id used in the public confirmation URL.
  publicId     String      @unique @default(cuid())
  /// Human friendly number shown to customers, e.g. "ORD-1024".
  orderNumber  String      @unique
  customerName String      @default("")
  notes        String      @default("")
  totalCents   Int
  /// One of: RECEIVED, PREPARING, READY, COMPLETED, CANCELLED
  status       String      @default("RECEIVED")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([status])
  @@index([createdAt])
}

/// A line on an order. Name and price are copied at order time so the order
/// history stays correct even if the menu item is later edited or deleted.
model OrderItem {
  id             String    @id @default(cuid())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItemId     String?
  foodItem       FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  name           String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
}

model Recipe {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  image        String   @default("")
  /// One ingredient per line.
  ingredients  String
  /// One step per line.
  instructions String
  /// Total preparation + cooking time, in minutes.
  cookingTime  Int
  servings     Int      @default(2)
  /// One of: Easy, Medium, Hard
  difficulty   String   @default("Easy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("Admin")
  passwordHash String
  /// Bumped on password change to invalidate existing sessions.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
